# Скопируй в .env и заполни (в git не попадает). Комментарий — только отдельной строкой:
# хвост после # уезжает в значение.
# SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SETTINGS_MODULE=knt.settings.prod
# Прокси для заблокированных ресурсов: сборка образа, телеграм.
PROXY=http://LOGIN:PASSWORD@IP:PORT
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://knt:PASSWORD@db:5432/knt
EMAIL_HOST_PASSWORD=
TELEGRAM_BOT_TOKEN=
# Токен пекарни (tools/bake.py) для /intake/. Пусто — приёмка закрыта.
# Только ASCII без пробелов: значение идёт в заголовок HTTP.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_TOKEN=
# Адрес сайта для пекарни; нужен только на машине с tools/bake.py. Пусто — локальная спека.
INTAKE_URL=https://knt-mipt.ru
# Токен второго сервера для /inbox/analytics/ (архивы → чат admin). Пусто — закрыто.
ANALYTICS_TOKEN=
# Домен раздачи файлов. Пусто — домен сайта (dev).
FILES_BASE_URL=https://files.inbicst.ru
# Cloudflare R2. Пусто — локальный диск media/: так живёт dev, боевой бакет не трогаем.
# Прямая загрузка крупных файлов работает только с R2.
# Перенос между диском и R2: manage.py storage_sync --check|--push|--pull
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Префикс ключей в бакете: прод — пусто, dev — dev.
R2_PREFIX=

# Каталог файлов на диске (без R2). Пусто — media/ в проекте.
MEDIA_ROOT=
