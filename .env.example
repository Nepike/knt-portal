# Скопируй в .env и заполни (в git не попадает).
# SECRET_KEY: python -c "from django.core.management.utils import get_random_secret_key as g; print(g())"
DJANGO_SETTINGS_MODULE=knt.settings.prod
# Общий прокси для заблокированных ресурсов (сборка Tailwind, позже TG-бот и т.п.)
PROXY=http://LOGIN:PASSWORD@IP:PORT
SECRET_KEY=
POSTGRES_PASSWORD=
DATABASE_URL=postgres://knt:PASSWORD@db:5432/knt
EMAIL_HOST_PASSWORD=
TELEGRAM_BOT_TOKEN=
# Токен приёмки медиа: по нему пекарня (tools/bake.py) ходит на /intake/. Пусто — закрыто.
# Только латиница и цифры, без пробелов: заголовки HTTP другого не несут. И помни, что
# хвост после # уедет прямо в значение — комментарий пиши отдельной строкой.
# Сгенерировать: python -c "import secrets; print(secrets.token_urlsafe(32))"
INTAKE_TOKEN=
# Адрес сайта, у которого пекарня спрашивает требования. Нужен ТОЛЬКО на машине, где
# запускается tools/bake.py; самому сайту не нужен. Пусто — печём по локальной копии.
INTAKE_URL=https://knt-mipt.ru
# Домен, с которого раздаются файлы и картинки. Пусто = тем же доменом, что и сайт (dev).
FILES_BASE_URL=https://files.inbicst.ru
# Cloudflare R2 — хранилище файлов книг и материалов. ПУСТО = локальный диск в media/,
# и так живёт разработка: в сеть не ходим, боевой бакет не трогаем.
# Заполнить локально стоит только чтобы проверить прямую загрузку крупных файлов —
# она работает лишь при включённом R2 (attachments.uploads.direct_upload).
# Перенос уже загруженного между диском и R2: manage.py storage_sync --check|--push|--pull
R2_BUCKET=
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
# Префикс ключей в бакете. Прод — пусто, разработке ставить dev, чтобы не мешать файлы.
R2_PREFIX=

# Куда складывать пользовательские файлы, когда они лежат на диске (R2 выключен).
# Пусто = media/ в проекте. Абсолютный путь нужен, когда на системном диске мало места.
MEDIA_ROOT=
