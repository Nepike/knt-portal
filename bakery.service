# Пекарня как служба. Ставится на машину с видеокартой, не на сервер сайта (docs/media-pipeline.md).
#
#   sudo cp bakery.service /etc/systemd/system/
#   sudo systemctl enable --now bakery
#   journalctl -u bakery -f
#
# Пути и пользователь — факультетской машины. Токен пекарня читает из `.env` рядом с собой.

[Unit]
Description=Пекарня КНТ: печёт лекции из очереди сайта
# Иначе первый `claim` после перезагрузки уходит в никуда.
After=network-online.target
Wants=network-online.target

[Service]
User=nepike
WorkingDirectory=/srv/bakery
ExecStart=/usr/bin/python3 /srv/bakery/tools/bake.py --serve
# Сырьё — десятки гигабайт, а /tmp на многих машинах в ОЗУ.
Environment=TMPDIR=/srv/bakery/tmp
Restart=always
RestartSec=30
# На остановку пекарня возвращает задание в очередь и ждёт ответа сайта до минуты; оборванное
# задание висело бы «обрабатывается» час. SIGTERM она понимает как Ctrl+C.
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
