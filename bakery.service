# Пекарня как служба: сама поднимается после перезагрузки, сама возвращается после
# осечки. Ставится на машину с видеокартой — не на сервер сайта, там ffmpeg нет
# и не будет (docs/media-pipeline.md).
#
#   sudo cp bakery.service /etc/systemd/system/
#   sudo systemctl enable --now bakery
#   journalctl -u bakery -f
#
# Пути и пользователь тут те, что на факультетской машине; на другой машине правятся
# три строки. Токен в юните не нужен: пекарня читает `.env` рядом с собой.

[Unit]
Description=Пекарня КНТ: печёт лекции из очереди сайта
# Сети на старте может ещё не быть. Без этого первый `claim` уходил бы в никуда,
# и после каждой перезагрузки пекарня минуту дремала бы вместо работы.
After=network-online.target
Wants=network-online.target

[Service]
User=nepike
WorkingDirectory=/srv/bakery
ExecStart=/usr/bin/python3 /srv/bakery/tools/bake.py --serve
# Рабочий каталог фазы: сюда ложится сырьё в десятки гигабайт и готовый набор рядом.
# Задавать обязательно: /tmp на многих машинах — это ОЗУ, и двухчасовая лекция
# не поместится в него никогда.
Environment=TMPDIR=/srv/bakery/tmp
Restart=always
RestartSec=30
# На остановку пекарня возвращает задание в очередь и снимает рабочий каталог, а ответа
# сайта ждёт до минуты. Обрывать её на этом нельзя: недосказанное задание висит человеку
# «обрабатывается» целый час. KillSignal править не нужно — SIGTERM она понимает
# как Ctrl+C.
TimeoutStopSec=150

[Install]
WantedBy=multi-user.target
